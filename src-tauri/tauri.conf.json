{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://127.0.0.1:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Lyrion",
    "version": "1.0.0-b"
  },
  "tauri": {
    "allowlist": {
      "process": {
        "all": false,
        "exit": true,
        "relaunch": false,
        "relaunchDangerousAllowSymlinkMacos": false
      },
      "all": false,
      "shell": {
        "sidecar": true,
        "scope": [
          {
            "name": "binaries/squeezelite",
            "sidecar": true,
            "args": true
          }
        ]
      },
      "fs": {
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "exists": true,
        "scope": [
          "$APPCONFIG",
          "$APPCONFIG/**"
        ]
      },
      "path": {
        "all": true
      },
      "window": {
        "setResizable": true,
        "setDecorations": true,
        "setPosition": true,
        "setSize": true,
        "startDragging": true,
        "show": true,
        "hide": true,
        "setFocus": true,
        "setAlwaysOnTop": true
      },
      "globalShortcut": {
        "all": true
      },
      "os": {
        "all": true
      },
      "http": {
        "all": true,
        "scope": [
          "http://*/**",
          "https://*/**",
          "http://*/*",
          "http://*/material",
          "http://*/material/*",
          "http://*/Material",
          "http://*/Material/*",
          "http://*/jsonrpc.js"
        ]
      }
    },
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lyrion",
        "width": 440,
        "height": 700,
        "minWidth": 320,
        "minHeight": 480,
        "fullscreen": false,
        "resizable": true,
        "visible": true,
        "hiddenTitle": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "focus": true,
        "transparent": false
      },
      {
        "label": "players",
        "title": "Platines",
        "width": 360,
        "height": 220,
        "minWidth": 360,
        "maxWidth": 360,
        "minHeight": 140,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "focus": false,
        "transparent": true,
        "fileDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "org.lyrion.app",
      "category": "Music",
      "shortDescription": "Lyrion — desktop client for Lyrion Music Server",
      "longDescription": "Lyrion is the turnkey desktop client for Lyrion Music Server: discover or install LMS, play with built-in Squeezelite, and control your library via Material Skin.",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": [
        "binaries/squeezelite"
      ],
      "macOS": {
        "minimumSystemVersion": "10.13"
      }
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    }
  }
}